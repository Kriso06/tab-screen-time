{
    "manifest_version":3,
    "name": "Tab Screen Time",
    "version": "1.0.0",
    "description": "Tracks daily active time spent on websites.",
    "permissions":["tabs", "storage", "idle","alarms"],
    "background": {
        "service_worker":"background.js"
    },
    "action":{
        "default_popup":"popup.html",
        "default_title":"Tab Screen Time"
    }
}